{
  "name": "@itsdalk-lane/pi-web",
  "version": "0.8.1-fork.0",
  "description": "Fork of Pi Web: a web UI for the pi coding agent",
  "private": true,
  "homepage": "https://github.com/ItsDalk-Lane/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsDalk-Lane/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/ItsDalk-Lane/pi-web/issues"
  },
  "author": "ItsDalk-Lane",
  "keywords": [
    "pi",
    "agent",
    "nextjs",
    "web-ui",
    "fork"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --test \"lib/**/*.test.mjs\" \"components/**/*.test.mjs\"",
    "test:pi-adapter": "node --test \"lib/adapters/pi/__tests__/*.test.mjs\"",
    "test:persistence": "node --test \"lib/phase3-persistence.test.mjs\"",
    "test:task-runtime": "node --test \"lib/phase3-task-runtime.test.mjs\"",
    "test:event-journal": "node --test \"lib/phase3-event-journal.test.mjs\"",
    "test:kernel": "node --test \"lib/kernel*.test.mjs\" \"lib/pi-task-projector.test.mjs\" \"lib/architecture-boundary.test.mjs\" \"lib/file-artifact.test.mjs\"",
    "test:workbench": "node --test \"lib/workbench.test.mjs\" \"components/artifacts/*.test.mjs\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:pi-adapter",
    "prepublishOnly": "npm run check && npm run build",
    "release": "npm run prepublishOnly && echo \"Publishing is disabled in this fork. Confirm package ownership before enabling npm publish.\"",
    "update:pi": "npm install --save-exact @earendil-works/pi-agent-core@latest @earendil-works/pi-ai@latest @earendil-works/pi-coding-agent@latest @earendil-works/pi-tui@latest && npm run typecheck && npm run lint",
    "electron:build": "npm run build && electron-builder",
    "electron:dev": "npm run build && node electron/launcher.js",
    "electron:start": "node electron/launcher.js"
  },
  "build": {
    "appId": "com.agegr.pi-web-desktop",
    "productName": "Pi Web Desktop",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "!.next/cache/**",
      "!.next/dev/**",
      "public/**/*",
      "next.config.ts",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/.cache/**",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/.github/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "next": "16.2.9",
    "pi-mcp-adapter": "^2.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "strip-json-comments": "^5.0.3",
    "undici": "8.5.0"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
