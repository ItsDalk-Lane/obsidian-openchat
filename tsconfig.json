{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "server-only": [
        "./server/server-only.ts"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "server/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "desktop.d.ts",
    "tailwind.config.ts",
    "vite.config.mts"
  ],
  "exclude": [
    "node_modules",
    "web/dist",
    "dist-electron"
  ]
}
